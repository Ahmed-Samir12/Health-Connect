extends baseEmail

block content
    .email-container
        h2.email-header Application Status Update

        p.email-content Dear Dr. #{userName},

        p.email-content Thank you for your interest in joining our healthcare platform.

        .security-notice
            p
                strong Application Status:
            p After careful review, we regret to inform you that we are unable to approve your doctor account application at this time.

        .info-box
            h3 Common reasons for rejection:
            ul
                li Incomplete or missing credentials
                li Documentation does not meet requirements
                li License verification issues
                li Insufficient professional information

        p.email-content If you believe this was an error or would like to reapply with updated information, please contact our support team.

        .button-container
            a.button(href=url) Contact Support

