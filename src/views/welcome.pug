doctype html
html(lang='en')
    head
        meta(charset='UTF-8')
        meta(name='viewport' content='width=device-width, initial-scale=1.0')
        meta(http-equiv='X-UA-Compatible' content='IE=edge')
        title Welcome to Healthcare System
        
        include _style

    body
        .email-container
            h2.email-header Welcome aboard, #{userName}! 🎉

            p.email-content Your email has been verified and your account is now active!

            .info-box
                h3 Getting Started:
                ul
                    li Complete your profile
                    li Browse available doctors
                    li Book your first appointment

            .button-container
                a.dashboard-button(href=dashboardURL) Go to Dashboard

            p.email-footer
                | Best regards,
                br
                | Healthcare Team